# Copia in .env e compila i valori

# IP locale del Raspberry Pi
PI_IP=192.168.1.X

# Pi-hole
PIHOLE_PASSWORD=cambia_questa_password

# WireGuard
WG_SERVER_URL=auto                      # oppure il tuo dominio DuckDNS (es. nome.duckdns.org)
WG_PEERS=3                              # numero di dispositivi client

# DuckDNS (necessario se IP pubblico dinamico)
DUCKDNS_SUBDOMAIN=il_tuo_subdomain      # solo il nome, senza .duckdns.org
DUCKDNS_TOKEN=incolla_qui_il_token      # token dalla pagina duckdns.org

# Notifiche (opzionale) — avvisi su update/backup falliti via ntfy.sh
# Scegli un topic difficile da indovinare e iscriviti dall'app ntfy.
# Lascia NTFY_TOPIC vuoto per disattivare le notifiche.
NTFY_TOPIC=                             # es. pi-home-a8f3kd
NTFY_URL=https://ntfy.sh                # server ntfy (default: pubblico)

# Backup (opzionale ma consigliato)
BACKUP_DEST=/mnt/usb/pi-home-backup     # cartella backup: meglio una USB/NAS, NON la SD!
BACKUP_KEEP=7                           # quanti backup tenere (rotazione)
